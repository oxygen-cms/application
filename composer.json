{
    "name": "oxygen/application",
    "description": "The Oxygen Starter Application.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": ">=8.3.0",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.0",
        "oxygen/auth": "~1.1.0",
        "oxygen/core": "~1.2.0",
        "oxygen/mod-pages": "~0.11.0",
        "oxygen/mod-media": "~0.12.0",
        "oxygen/mod-import-export": "~0.7.0",
        "nunomaduro/collision": "^8.1",
        "spatie/laravel-ignition": "^2.0",
        "sentry/sentry-laravel": "^4.0",
        "ext-json": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-imagick": "*",
        "ext-dom": "*",
        "mailgun/mailgun-php": "^3.4",
        "pda/pheanstalk": "~4.0"
    },
    "require-dev": {
        "filp/whoops": "~2.0",
        "mockery/mockery": "^1.3.1",
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.2",
        "fakerphp/faker": "*"
    },
    "autoload": {
        "classmap": [
            "tests"
        ],
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/TestCase.php"
        ]
    },
    "scripts": {
        "post-install-cmd": [
            "php artisan clear-compiled",
            "php artisan vendor:publish --tag=public --force"
        ],
        "post-update-cmd": [
            "php artisan clear-compiled",
            "php artisan vendor:publish --tag=public --force",
            "php artisan doctrine:generate:proxies",
            "php artisan doctrine:schema:update",
            "php artisan migrate",
            "php artisan optimize"
        ],
        "post-root-package-install": [
            "php -r \"copy('.env.example', '.env');\"",
            "php artisan make:user"
        ],
        "post-create-project-cmd": [
            "php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ],
        "test": "vendor/bin/phpunit && vendor/bin/phpstan analyze app --memory-limit 256M --level 6"
    },
    "config": {
        "preferred-install": "dist",
        "optimize-autoloader": true,
        "discard-changes": true,
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
