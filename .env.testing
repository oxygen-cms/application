APP_ENV=testing
APP_DEBUG=true
APP_KEY=base64:4cWQk9A5t3EbKJut1pS66q7857alyzZ0rSZw4oEaE6M=

# Use file-based SQLite for testing (in-memory doesn't work with HTTP requests)
DB_CONNECTION=sqlite
DB_DATABASE=storage/database.sqlite

# Fast bcrypt for tests
BCRYPT_ROUNDS=4

# Use array drivers for fast tests
CACHE_DRIVER=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array

# Disable telescope
TELESCOPE_ENABLED=false
